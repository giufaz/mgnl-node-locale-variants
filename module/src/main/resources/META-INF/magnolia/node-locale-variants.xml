<!DOCTYPE module SYSTEM "module.dtd">
<module>
  <name>node-locale-variants</name>
  <displayName>Node Locale Variants</displayName>
  <description>${project.description}</description>
  <class>com.giufaz.magnolia.localevariants.NodeLocaleVariantsModule</class>
  <version>${project.version}</version>

  <components>
    <id>main</id>
    <component>
      <type>com.giufaz.magnolia.localevariants.LocaleVariantStructure</type>
      <implementation>com.giufaz.magnolia.localevariants.LocaleVariantStructure</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>com.giufaz.magnolia.localevariants.LocaleVariantCreator</type>
      <implementation>com.giufaz.magnolia.localevariants.LocaleVariantCreator</implementation>
      <scope>singleton</scope>
    </component>
    <!-- Class that identifies reference resolver to wrap with localized variants logic: 
        a project can map its own implementation -->
    <component>
      <type>com.giufaz.magnolia.localevariants.delivery.JcrReferenceResolverDetector</type>
      <implementation>com.giufaz.magnolia.localevariants.delivery.JcrReferenceResolverDetector</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>com.giufaz.magnolia.localevariants.app.activation.AppActivation</type>
      <implementation>com.giufaz.magnolia.localevariants.app.activation.AppActivation</implementation>
      <scope>singleton</scope>
    </component>
    <!-- Decorates the apps enabled in the module config (apps) -->
    <component>
      <type>info.magnolia.ui.api.app.registry.AppDescriptorRegistry</type>
      <implementation>com.giufaz.magnolia.localevariants.app.activation.LocaleVariantsAppDescriptorRegistry</implementation>
    </component>
  </components>

  <!-- Locale variants authored in one language in Vaadin dialogs and in the page editor: wraps the authoring support
       mapped in "main", and only acts in the apps of the module config -->
  <components>
    <id>subapp</id>
    <component>
      <type>info.magnolia.ui.api.i18n.I18NAuthoringSupport</type>
      <implementation>com.giufaz.magnolia.localevariants.app.form.LocaleVariantI18nAuthoringSupport</implementation>
    </component>
  </components>

  <dependencies>
    <dependency>
      <name>core</name>
      <version>6.4/*</version>
    </dependency>
    <dependency>
      <name>site</name>
    </dependency>
    <dependency>
      <name>magnolia-rest-jcr-delivery</name>
    </dependency>
    <!-- After ui-framework-jcr, which binds the app registry to its configuration source -->
    <dependency>
      <name>ui-framework-jcr</name>
    </dependency>
    <!-- Page variants get their missing areas only if Pages REST exists at runtime,
         which should be the default case -->
    <dependency>
      <name>pages-jcr-rest</name>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <!-- Node types are registered once per Jackrabbit repository: available in every workspace of "magnolia" -->
  <repositories>
    <repository>
      <name>magnolia</name>
      <workspaces>
        <workspace>website</workspace>
      </workspaces>
      <nodeTypeFile>/mgnl-nodetypes/node-locale-variants-nodetypes.cnd</nodeTypeFile>
    </repository>
  </repositories>
</module>
