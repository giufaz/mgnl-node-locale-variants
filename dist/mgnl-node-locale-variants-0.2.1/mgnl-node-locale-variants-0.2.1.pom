<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.giufaz</groupId>
  <artifactId>mgnl-node-locale-variants</artifactId>
  <version>0.2.1</version>
  <name>Magnolia Node Locale Variants</name>
  <description>Locale variants of any JCR node for Magnolia 6.4+: content items, pages and generic nodes. Integrates with Magnolia apps, dialogs and the Delivery API.</description>
  <url>https://github.com/giufaz/mgnl-node-locale-variants</url>
  <developers>
    <developer>
      <id>giufaz</id>
      <name>Giulian</name>
      <url>https://github.com/giufaz</url>
    </developer>
  </developers>
  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/giufaz/mgnl-node-locale-variants.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/giufaz/mgnl-node-locale-variants.git</developerConnection>
    <url>https://github.com/giufaz/mgnl-node-locale-variants</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>info.magnolia</groupId>
      <artifactId>magnolia-core</artifactId>
      <version>6.4.10</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.20.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia.site</groupId>
      <artifactId>magnolia-site</artifactId>
      <version>3.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia.rest</groupId>
      <artifactId>magnolia-rest-jcr-delivery</artifactId>
      <version>4.0.8</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia.ui</groupId>
      <artifactId>magnolia-ui-framework</artifactId>
      <version>6.4.10</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia.ui</groupId>
      <artifactId>magnolia-ui-framework-jcr</artifactId>
      <version>6.4.10</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia.pages</groupId>
      <artifactId>magnolia-pages-jcr-rest</artifactId>
      <version>6.4.5</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia.pages</groupId>
      <artifactId>magnolia-spa-rendering</artifactId>
      <version>6.4.5</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia.warp</groupId>
      <artifactId>form-vaadin-integration</artifactId>
      <version>1.0.9</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>
